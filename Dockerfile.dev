# Ambiente di sviluppo: nessuna dipendenza installata sull'host.
FROM node:22-bookworm-slim

# curl serve all'healthcheck e a git/ca-certificates per alcuni pacchetti npm
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000
CMD ["npm", "run", "dev"]
